# .env.example — Phase-1 Compose tunables (ADR-001 guardrail: tunables live in env/config,
# never baked into images). Copy to `.env` (git-ignored) and adjust. These are the knobs the
# baseline is expected to expose; wire them into docker-compose.yaml / configs at M2.

# --- Identity (must stay consistent across AMF/NSSF/SMF/subscriber/UERANSIM — see M0 audit) ---
PLMN_MCC=208
PLMN_MNC=93
TAC=1

# --- Modeled single slice (ADR-007) ---
SLICE_SST=1
SLICE_SD=010203
DNN=internet

# --- Logging (ADR-005: JSON to the machine path, INFO by default) ---
LOG_LEVEL=info

# --- Images: source is pinned to free5GC v4.2.3; ported compose currently uses v4.2.0 images.
# Reconcile at M2 (see VERSIONS.lock.container_images).
FREE5GC_IMAGE_TAG=v4.2.0
MONGO_IMAGE=mongo:4.4
