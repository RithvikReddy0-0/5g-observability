# slices.env — the single definition of every network slice in this deployment.
#
# Sourced by scripts/provision_subscribers.sh (to write real 3GPP subscriber records) and
# read by tools/slice-orchestrator (to make admission decisions). Keeping one file means the
# orchestrator can never drift from what the core is actually provisioned with.
#
# WHAT MAKES A SLICE DIFFERENT
# A slice is not just an identifier — it is a service class. Two slices with identical QoS
# are two labels for the same thing. These two are genuinely different:
#
#   Slice A (eMBB)  — enhanced Mobile BroadBand. Lots of bandwidth, best effort, tolerant of
#                     delay. Suits video streaming and file transfer.
#   Slice B (URLLC) — Ultra-Reliable Low-Latency Communication. Small bandwidth, tight delay
#                     budget, high priority, can preempt other traffic. Suits control
#                     signalling and interactive/low-latency requests.
#
# SST values are standardised in 3GPP TS 23.501 Table 5.15.2.2-1:
#   SST 1 = eMBB   SST 2 = URLLC   SST 3 = MIoT   SST 4 = V2X
#
# CAVEAT: these are real subscriber-record values, but QoS is only ENFORCED by a user plane
# (UPF). Without gtp5g they describe intent; the orchestrator models the enforcement.
# On the Open5GS stack the user plane runs, and session AMBR is enforced by the gNB.

# ─────────────────────────── Slice A — eMBB ───────────────────────────
SLICE_A_NAME="eMBB"
SLICE_A_SST=1
SLICE_A_SD=010203
SLICE_A_5QI=9                      # non-GBR, best effort
SLICE_A_ARP_PRIORITY=8             # low priority (1=highest, 15=lowest)
SLICE_A_ARP_PREEMPT_CAP=""         # cannot preempt others
SLICE_A_ARP_PREEMPT_VULN="PRE_EMPTABLE"
SLICE_A_SESSION_AMBR_DL="200 Mbps"
SLICE_A_SESSION_AMBR_UL="200 Mbps"
SLICE_A_UE_AMBR_DL="2 Gbps"
SLICE_A_UE_AMBR_UL="1 Gbps"
SLICE_A_CAPACITY_MBPS=200          # ceiling the orchestrator admits against
SLICE_A_MAX_LATENCY_MS=300         # what this slice can promise
SLICE_A_SUBSCRIBERS=10

# ─────────────────────────── Slice B — URLLC ──────────────────────────
SLICE_B_NAME="URLLC"
SLICE_B_SST=2
SLICE_B_SD=112233
SLICE_B_5QI=82                     # delay-critical GBR, 10 ms packet delay budget
SLICE_B_ARP_PRIORITY=2             # high priority
SLICE_B_ARP_PREEMPT_CAP="MAY_PREEMPT"
SLICE_B_ARP_PREEMPT_VULN="NOT_PREEMPTABLE"
SLICE_B_SESSION_AMBR_DL="20 Mbps"
SLICE_B_SESSION_AMBR_UL="20 Mbps"
SLICE_B_UE_AMBR_DL="50 Mbps"
SLICE_B_UE_AMBR_UL="50 Mbps"
SLICE_B_CAPACITY_MBPS=20           # deliberately scarce — makes admission control visible
SLICE_B_MAX_LATENCY_MS=10
SLICE_B_SUBSCRIBERS=10

# Other slices each subscriber may use besides its home slice (letters). eMBB and URLLC devices
# may use either — that gives the orchestrator a real choice. IoT devices are mMTC only.
SLICE_A_ALSO_PERMITTED="B"
SLICE_B_ALSO_PERMITTED="A"

# ─────────────────────────── Slice C — mMTC ───────────────────────────
# Massive machine-type communication: many devices, each sending a few bytes periodically and
# sleeping in between (a sensor reporting ten bytes). What stresses the network is the NUMBER
# of devices and their signalling, not bandwidth — 70 such devices amount to a few kbit/s.
# Open5GS stack only (Phase 2b); the free5GC stack keeps slices A and B.
SLICE_C_NAME="mMTC"
SLICE_C_SST=3                      # MIoT
SLICE_C_SD=334455
SLICE_C_5QI=9                      # non-GBR, delay-tolerant
SLICE_C_ARP_PRIORITY=12            # lowest of the three: IoT reports can wait
SLICE_C_ARP_PREEMPT_CAP=""         # cannot preempt others
SLICE_C_ARP_PREEMPT_VULN="PRE_EMPTABLE"
SLICE_C_SESSION_AMBR_DL="1 Mbps"
SLICE_C_SESSION_AMBR_UL="1 Mbps"
SLICE_C_UE_AMBR_DL="2 Mbps"
SLICE_C_UE_AMBR_UL="2 Mbps"
SLICE_C_CAPACITY_MBPS=10
SLICE_C_MAX_LATENCY_MS=1000        # a report may take a second to arrive
SLICE_C_SUBSCRIBERS=70
SLICE_C_ALSO_PERMITTED=""

# ──────────────── Open5GS deployment: 100 UEs (Phase 2b) ────────────────
# UEs per slice on the Open5GS stack — the 10 / 20 / 70 split of the Phase 2b brief
# (docs/briefs/phase2b-work-division.md). The free5GC stack keeps SLICE_*_SUBSCRIBERS.
# IMSIs are assigned in this order, contiguously:
#   eMBB 208930000000001-020, URLLC 208930000000021-030, mMTC 208930000000031-100.
# scripts/open5gs/provision_subscribers.py writes them; the UE container's UE_PLAN
# (deployments/open5gs/docker-compose.yaml) must match, and tools/check_open5gs_slices.py
# fails CI if it does not.
O5GS_UES="A=20 B=10 C=70"

# ─────────────────────── Traffic classes → requirements ───────────────
# What each kind of traffic actually needs. The orchestrator matches these against the
# slices above; it does NOT hardcode "video goes to slice A".
#   <name>:<mbps needed>:<max tolerable latency ms>
TRAFFIC_CLASSES="video:8:300 file:15:300 blog:1:20 control:1:10"
