      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prom-o5gs"
      },
      "description": "UPF gauge. A lower bound: after a UE restart it read 21 for 20 real sessions. The exact per-slice count is the SMF panel below.",
