{
  "uid": "open5gs-slices",
  "title": "Open5GS \u2014 slices, sessions and traffic",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "open5gs",
    "slicing"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Core \u2014 control plane (native Open5GS metrics)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "gNBs connected",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prom-o5gs"
      },
      "description": "AMF metric `gnb`.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#2E6E8E"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-o5gs"
          },
          "expr": "sum(gnb)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
