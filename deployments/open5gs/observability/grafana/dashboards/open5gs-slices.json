    {
      "type": "timeseries",
      "title": "PDU sessions per slice",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prom-o5gs"
      },
      "description": "Native SMF gauge, labelled by S-NSSAI \u2014 slice identity that free5GC's metrics never carried.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(eMBB|1-010203|internet).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E6E8E"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(URLLC|2-112233|urllc).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C7601F"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-o5gs"
          },
          "expr": "sum by (snssai) (fivegs_smffunction_sm_sessionnbr)",
          "legendFormat": "S-NSSAI {{snssai}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "User-plane QoS flows per slice (UPF, by DNN)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prom-o5gs"
      },
      "description": "UPF gauge; DNN internet = eMBB, urllc = URLLC. Presence per slice; can over-count after a UE restart. The SMF's qos_flow_nbr{snssai,fiveqi} is NOT shown: it read 20/20 against 10/10 real flows because it is never decremented on re-attach.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
