# --- Pinned upstreams: fetched by scripts/bootstrap.sh, NEVER committed (SPEC ADR-002) ---
/external/

# --- Local env / secrets (keep .env.example) ---
.env
.env.local
*.local.env

# --- Python (traffic sim tooling) ---
__pycache__/
*.py[cod]
venv/
.venv/

# --- TLS material: free5GC auto-generates these into the bind-mounted cert dir
#     at first start. They are runtime artifacts and include PRIVATE KEYS.
#     Never commit them (this repo is public); they regenerate on a clean run. ---
deployments/compose/cert/
*.key
*.pem

# --- Runtime artifacts / logs ---
/logs/
*.log
# ...except recorded log lines the observability tests parse (ADR-024; small, anonymised)
!tests/fixtures/observability/*.log
*_logs.txt

# --- OS / editor cruft ---
.DS_Store
Thumbs.db

# --- Claude Code local machine state ---
.claude/settings.local.json

# scripts/open5gs/deploy.sh state: known-good and rejected snapshots (local, never committed)
/.deploy/

# The project report has the team's names and roll numbers: kept local (2026-11-08).
# Its figures (docs/report/figures) and the tools that make them are committed.
docs/report/full/
docs/report/*.tex
docs/report/*.pdf
docs/report/*.log
docs/report/*.aux
